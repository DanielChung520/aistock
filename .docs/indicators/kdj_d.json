{
  "metric": "kdj_d",
  "name": "KDJ D 值",
  "category": "momentum",
  "definition": "KDJ 隨機指標的 D 值，為 K 值的 3 日平滑（移動平均），走勢較 K 值滯後，K 值與 D 值的交叉是常用買賣訊號。",
  "formula": "D = (1/3) × K + (2/3) × D[t-1]（初始 D=50）",
  "parameters": [
    {
      "name": "period",
      "default": 9,
      "range": [
        2,
        100
      ],
      "tw_convention": "台股慣用 9"
    },
    {
      "name": "d_smooth",
      "default": 3,
      "range": [
        1,
        10
      ],
      "tw_convention": "台股慣用 3"
    }
  ],
  "inputs": [
    "high",
    "low",
    "close"
  ],
  "outputs": {
    "type": "number",
    "range": [
      0,
      100
    ],
    "meaning": ">80 超買區，<20 超賣區；作為 K 值交叉的基準線"
  },
  "implementation": {
    "implemented": true,
    "function": "calculate_kdj",
    "catalog_metric": "kdj_d"
  },
  "depends_on": [
    "kdj_k"
  ],
  "signals": [
    {
      "pattern": "黃金交叉",
      "condition": "kdj_k 上穿 kdj_d（cross_above，低檔金叉更佳）"
    },
    {
      "pattern": "死亡交叉",
      "condition": "kdj_k 下穿 kdj_d（cross_below，高檔死叉更佳）"
    }
  ],
  "combines_with": [
    "kdj_k",
    "kdj_j",
    "rsi"
  ],
  "notes": "來源：TA-Lib STOCH（KD 隨機指標）。台股慣例：KDJ(9,3,3)；D 值為 K 值平滑線，交叉訊號以 K 值穿越 D 值為準，需用 cross_above / cross_below 運算子。",
  "tags": [
    "動能",
    "黃金交叉",
    "死亡交叉",
    "kdj_k",
    "kdj_j",
    "rsi"
  ],
  "llm_intent": "衡量價格變動的動能與速度，用於尋找超買超賣或動能持續性（KDJ D 值）"
}
